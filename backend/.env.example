NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
SERVE_WEB=false
# Prefixo opaco da API (não use /api). Frontend espelha em src/lib/httpSurface.js
HTTP_SURFACE_ROOT=/g

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ezern_admin_app
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Obrigatório: mínimo 32 caracteres. Em produção, valor aleatório forte (não use placeholders).
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Em produção o boot força true.
COOKIE_SECURE=false

# Em produção o boot exige graph + GRAPH_* + sender real.
EMAIL_TRANSPORT=log
DEFAULT_SENDER_MAILBOX=noreply@example.com
SUPPORT_INBOX_EMAIL=suporte@ezern.com.br
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

BLOB_CONNECTION_STRING=
BLOB_CONTAINER=documents

# Places API (New). Restrinja a chave por IP do servidor.
GOOGLE_PLACES_API_KEY=

# Só ative quando o login Microsoft estiver implementado.
MICROSOFT_SSO_ENABLED=false

# Opcional: token para /api/health/ready fora de localhost.
HEALTH_READY_TOKEN=

# Produção com frontend em outro host (lista separada por vírgula). Com SERVE_WEB=true, CORS fica desligado.
# CORS_ORIGINS=https://admin.exemplo.com
